          "need": [
            "tp"
          ]
        },
        {
          "id": "lead.past.same.b",
          "text": "Aynı soruyu {tp} de sormuştun",
          "bias": 0.92,
          "when": {
            "gap_ge": 45,
            "same": true
          },
          "need": [
            "tp"
          ]
        },
        {
          "id": "lead.past.near.a",
          "text": "Bunu {tp} de söylemiştin, neredeyse aynı sözlerle",
          "bias": 0.9,
          "when": {
            "gap_ge": 45,
            "same": false
          },
          "need": [
            "tp"
