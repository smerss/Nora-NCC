        },
        {
          "id": "frame.order.b",
          "text": "{subj}, iki yönüyle aklımda: {a}; {b}.",
          "bias": 0.97,
          "when": {
            "eq": {
              "frame": "order"
            }
          },
          "need": [
            "subj",
            "a",
            "b"
          ]
        },
        {
          "id": "frame.fallback",
          "text": "Bildiğim bu: {tail}",
          "bias": 1.0,
          "when": {
            "eq": {
              "frame": "fallback"
            }
          },
          "need": [
            "tail"
          ]
        },
        {
          "id": "frame.limit",
          "text": "{head}; ötesini henüz bilmiyorum.",
          "bias": 1.0,
          "when": {
            "eq": {
              "frame": "limit"
            }
          },
          "need": [
            "head"
          ]
        }
      ]
