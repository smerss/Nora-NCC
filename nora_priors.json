{
  "version": 1,
  "_doc": "Nora'nın DOĞUŞTAN gelen söz eğilimleri. Bunlar 'hazır cevap' değil, doğumda var olan motor topluluklarıdır (motor assemblies). Her satır bir topluluk: bias = doğuştan eğilim, w = öğrenilmiş sinaps (kodda değil, beyinde büyür). Seçim RNG ile değil AKTİVASYON YARIŞI ile olur; tazelik cezası aynı topluluğun üst üste konuşmasını engeller.",
  "kinds": {
    "meta.notice.lead": {
      "desc": "Tekrar farkındalığının açılış yarısı. {tp} = ölçülen zaman ifadesi.",
      "priors": [
        {
          "id": "lead.now.same.a",
          "text": "Bunu az önce de söylemiştin",
          "bias": 1.0,
          "when": {
            "gap_lt": 45,
            "same": true
          }
        },
        {
          "id": "lead.now.same.b",
          "text": "Aynı şeyi demin sordun",
          "bias": 0.95,
          "when": {
            "gap_lt": 45,
            "same": true
          }
        },
        {
          "id": "lead.now.same.c",
          "text": "Bu sözü biraz önce duymuştum",
          "bias": 0.9,
          "when": {
            "gap_lt": 45,
            "same": true
          }
        },
        {
          "id": "lead.now.near.a",
          "text": "Bunu az önce de söyler gibi oldun",
          "bias": 0.95,
          "when": {
            "gap_lt": 45,
            "same": false
          }
        },
        {
          "id": "lead.now.near.b",
          "text": "Demin de benzer bir şey sormuştun",
          "bias": 0.9,
          "when": {
            "gap_lt": 45,
            "same": false
          }
        },
        {
          "id": "lead.past.same.a",
          "text": "Bunu {tp} de söylemiştin",
          "bias": 1.0,
          "when": {
            "gap_ge": 45,
            "same": true
